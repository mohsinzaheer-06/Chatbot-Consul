# GEMINI_API_KEY: Required for Gemini AI API calls (keep strictly server-side).
# Obtain a free-tier key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Free-tier Gemini model used by /api/chat for text and multimodal document/image analysis.
# Default: gemini-3.1-flash-lite (automatically falls back to gemini-3.5-flash-lite / gemini-3.8-flash / gemini-4-hydrogen)
GEMINI_MODEL="gemini-3.1-flash-lite"

# GEMINI_LIVE_MODEL: Gemini Live API model for real-time bidirectional voice conversations.
# Verified only when GEMINI_API_KEY is configured and permitted on your Gemini tier.
GEMINI_LIVE_MODEL="gemini-3.8-live"

# GEMINI_IMAGE_MODEL: Leave empty in strict free-only mode.
# Official Gemini image-generation models (e.g., gemini-3.1-flash-lite-image, gemini-nano-banana-2.1)
# require a paid API key, so this stays unset by default to avoid unexpected billing.
GEMINI_IMAGE_MODEL=""

# Optional free-tier external image adapter (e.g., Hugging Face Serverless Inference free monthly credits).
# Leave empty to keep image generation disabled cleanly with zero external billing.
HF_API_TOKEN=""
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
